{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES6",
    "lib": ["ES6", "DOM"],
    "outDir": "./out",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "extension.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
