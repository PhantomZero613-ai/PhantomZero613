{
  "shader_full": {
    "prefix": "shader",
    "body": [
      "${1:shaderName}Applied = false",
      "",
      "function onStartCountdown()",
      "    if shadersEnabled then",
      "        debugPrint('Loading ${1:shaderName} Shader')",
      "        runHaxeCode([[",
      "            game.initLuaShader('${1:shaderName}');",
      "        ]])",
      "        ",
      "        makeLuaSprite('${1:shaderName}Shader')",
      "        setSpriteShader('${1:shaderName}Shader', '${1:shaderName}')",
      "        ",
      "        runHaxeCode([[",
      "            var shaderFilter = new ShaderFilter(game.getLuaObject(\"${1:shaderName}Shader\").shader);",
      "            game.camGame.setFilters([shaderFilter]);",
      "        ]])",
      "        ",
      "        setShaderFloat('${1:shaderName}Shader', 'time', 0.0)",
      "        setShaderFloat('${1:shaderName}Shader', '${2:uniform}', ${3:0.5})",
      "        ",
      "        ${1:shaderName}Applied = true",
      "    end",
      "end",
      "",
      "function onUpdatePost(elapsed)",
      "    if ${1:shaderName}Applied then",
      "        setShaderFloat('${1:shaderName}Shader', 'time', getSongPosition() / 1000.0)",
      "    end",
      "end"
    ],
    "description": "Complete shader activation with uniform setup"
  },
  "sprite_with_tween": {
    "prefix": "sprite-tween",
    "body": [
      "makeLuaSprite('${1:spriteId}', '${2:path/to/image}', ${3:x}, ${4:y})",
      "addLuaSprite('${1:spriteId}', ${5:false})",
      "",
      "doTweenY('${1:spriteId}_tween', '${1:spriteId}', ${6:endValue}, ${7:duration}, '${8:linear}')"
    ],
    "description": "Create sprite with Y tween"
  },
  "sprite_animation": {
    "prefix": "sprite-anim",
    "body": [
      "makeAnimatedLuaSprite('${1:spriteId}', '${2:image}', ${3:x}, ${4:y})",
      "addAnimationByPrefix('${1:spriteId}', '${5:idle}', '${5:idle}', 24, true)",
      "objectPlayAnimation('${1:spriteId}', '${5:idle}', true)",
      "addLuaSprite('${1:spriteId}', false)"
    ],
    "description": "Create animated sprite with prefix animation"
  },
  "camera_shake": {
    "prefix": "cam-shake",
    "body": [
      "cameraShake(${1:camGame}, ${2:0.01}, ${3:0.2})"
    ],
    "description": "Shake camera effect"
  },
  "callback_loop": {
    "prefix": "callback",
    "body": [
      "function ${1:onUpdate}(elapsed)",
      "    ${2:-- TODO: implement}",
      "end"
    ],
    "description": "Psych callback function"
  },
  "note_event": {
    "prefix": "note-event",
    "body": [
      "function goodNoteHit(membersIndex, noteData, noteType, isSustainNote)",
      "    debugPrint('Good note hit! Note: ' .. noteData)",
      "    -- noteData: 0=LEFT, 1=DOWN, 2=UP, 3=RIGHT",
      "    ${1:-- TODO: implement hit effect}",
      "end"
    ],
    "description": "Good note hit event handler"
  },
  "event_handler": {
    "prefix": "event",
    "body": [
      "function ${1:eventName}(value1, value2)",
      "    debugPrint('Event triggered: ${1:eventName}', 'Value1: ' .. tostring(value1), 'Value2: ' .. tostring(value2))",
      "    ${0:-- TODO: implement event}",
      "end"
    ],
    "description": "Custom event handler with parameters"
  },
  "character_def": {
    "prefix": "character",
    "body": [
      "{",
      "  \"animations\": [",
      "    {",
      "      \"anim\": \"idle\",",
      "      \"name\": \"Idle\",",
      "      \"offsets\": [0, 0],",
      "      \"loop\": true",
      "    }",
      "  ],",
      "  \"image\": \"characters/${1:characterName}\",",
      "  \"scale\": 1.0,",
      "  \"sing_duration\": 4.0,",
      "  \"healthicon\": \"${1:characterName}\"",
      "}"
    ],
    "description": "Character JSON template"
  },
  "song_def": {
    "prefix": "song",
    "body": [
      "{",
      "  \"song\": \"${1:Song Name}\",",
      "  \"player1\": \"${2:bf}\",",
      "  \"player2\": \"${3:dad}\",",
      "  \"stage\": \"${4:stage}\",",
      "  \"gfVersion\": \"${5:gf}\",",
      "  \"validScore\": true,",
      "  \"needsVoices\": true,",
      "  \"bpm\": ${6:120},",
      "  \"notes\": [],",
      "  \"events\": []",
      "}"
    ],
    "description": "Song metadata JSON template"
  },
  "shader_vec2": {
    "prefix": "shader-vec2",
    "body": [
      "setShaderVec2('${1:spriteId}', '${2:uniformName}', ${3:0.0}, ${4:0.0})"
    ],
    "description": "Set vec2 shader uniform"
  },
  "shader_vec3": {
    "prefix": "shader-vec3",
    "body": [
      "setShaderVec3('${1:spriteId}', '${2:uniformName}', ${3:0.8}, ${4:0.2}, ${5:1.0})"
    ],
    "description": "Set vec3 shader uniform (RGB color example)"
  }
}
